# 复制为项目根目录的 .env，server 启动时用 Node 原生 process.loadEnvFile 读取。
# 只认项目根这一份：server 不会向父目录或磁盘其他位置查找 .env。
# 只允许回环地址：server 拒绝监听非本机地址。
HOST=127.0.0.1
PORT=8787
# 可选：经本机反向代理对外提供服务时填写，例如 https://waterbot.example.com。
# server 仍只监听回环；该值用于校验 Host / Origin 并给会话 cookie 加 Secure。
# PUBLIC_ORIGIN=

# web 开发服务器（vite.config.ts）也从这份根 .env 读取 VITE_SERVER_ORIGIN，
# 用来设置 /api 的代理目标；进程环境变量优先于该文件。
# 只取这一个键：其他变量不会被 web 读取，也不会注入到客户端 import.meta.env
# （vite 的 envDir 仍是 apps/web，根 .env 不参与客户端变量生成）。
VITE_SERVER_ORIGIN=http://127.0.0.1:8787

# 可选：覆盖 Pi runtime 的本地数据位置（默认在 apps/server/data 下，已被忽略）。
# RUNTIME_SQLITE_PATH=apps/server/data/runtime.sqlite
# RUNTIME_NOTES_DIR=apps/server/data/notes
# 可选：覆盖全部运行数据根目录；runtime.sqlite、notes、documents、browser-profiles、
# browser-shots 和 workspaces 都会放在它下面。
# WATERBOT_DATA_DIR=apps/server/data

# 浏览器工作面使用宿主已安装的 Edge 或 Chrome。默认 msedge；服务器没有该浏览器时
# 浏览器接口会明确返回启动失败，不会退回访问任意宿主文件。
# BROWSER_CHANNEL=msedge

# GitHub 只读连接器：公共仓库不需要 token；私有仓库或更高额度再填写。
# GITHUB_TOKEN=
# GitHub Enterprise 或本地测试可覆盖 API 根地址。
# GITHUB_API_BASE=https://api.github.com

# 具名连接器：只有需要使用的供应商才填写对应凭据。所有发送仍走 Action 审批 / 限额。
# Notion Integration token；页面读取和追加段落。
# NOTION_TOKEN=
# NOTION_BASE_URL=https://api.notion.com
# Slack Bot token；读取频道 / 消息和发消息。
# SLACK_BOT_TOKEN=
# SLACK_BASE_URL=https://slack.com/api
# X 只读 Bearer token；没有写入凭据。
# X_BEARER_TOKEN=
# X_BASE_URL=https://api.x.com/2
# B站公开读取；写评论还需要完整 Cookie 中的 bili_jct。
# BILIBILI_COOKIE=
# BILIBILI_BASE_URL=https://api.bilibili.com
# CalDAV 日历；CALDAV_CALENDAR 为日历显示名，留空取第一个。
# CALDAV_URL=
# CALDAV_USERNAME=
# CALDAV_PASSWORD=
# CALDAV_CALENDAR=
# 邮箱 IMAP 读取和 SMTP 发送；七项必须同时设置。
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_SECURE=1
# IMAP_USER=
# IMAP_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# 语音留言：OpenAI 兼容的转写 / 合成端点。只填需要的方向；不填则接口明确返回未配置。
# VOICE_STT_URL=https://api.openai.com/v1/audio/transcriptions
# VOICE_STT_MODEL=whisper-1
# VOICE_TTS_URL=https://api.openai.com/v1/audio/speech
# VOICE_TTS_MODEL=tts-1
# VOICE_TTS_VOICE=alloy
# VOICE_API_KEY=

# 产品业务库：留空则使用本项目开发集群（npm run pg:start 生成，密码存忽略文件）。
# 填了就直接用这个 URL，server 不再读开发集群配置。不要把真实密码写进仓库。
# DATABASE_URL=postgres://postgres:<password>@127.0.0.1:55434/waterbot
# 开发集群端口（默认 55434；55432 在本机被 Windows 端口策略拒绝）
# PG_PORT=55434

# QQ（OneBot v11 正向 WebSocket，协议端如 NapCat 单独运行）。三项都不填则不启用。
# Bot 必须是专用小号；owner 身份只认这里的 QQ 号。
# ONEBOT_WS_URL=ws://127.0.0.1:3001
# ONEBOT_ACCESS_TOKEN=
# QQ_BOT_ID=
# QQ_OWNER_ID=
# 可选：Bot 使用的人格，默认第一个人格。
# QQ_PROFILE_ID=
# 真实外发开关：设为 1 才会向 QQ 发消息，默认只接收。
# QQ_ALLOW_SEND=0
# 每个 QQ 会话 24 小时模型 token 上限；0 表示不限制。超额后只存档不回复。
# QQ_DAILY_TOKEN_LIMIT=0

# 真实模型：OpenAI Completions 兼容端点。三项全填才启用，全空使用 faux。
# OPENAI_BASE_URL=http://127.0.0.1:3425/v1
# OPENAI_API_KEY=
# MODEL_ID=
# 兼容旧名：OPENAI_MODEL 优先于 MODEL_ID。
# OPENAI_MODEL=

# 逻辑备份口令（至少 12 个字符）；只在本机备份 / 恢复时使用。
# BACKUP_PASSPHRASE=

# QQ 空间写入开关：默认 0，只读。设为 1 后才允许已批准的评论动作真正发出。
# QZONE_ALLOW_WRITE=0

# 联网查证默认走 Bing，免注册、免密钥。设为 1 可关闭。
# SEARCH_DISABLED=0
# 每 24 小时最多搜索次数，默认 100。
# SEARCH_DAILY_LIMIT=100
# 可选：填了 Tavily 密钥就改用 Tavily。
# TAVILY_API_KEY=
