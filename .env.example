# 复制为项目根目录的 .env，server 启动时用 Node 原生 process.loadEnvFile 读取。
# 只认项目根这一份：server 不会向父目录或磁盘其他位置查找 .env。
# 只允许回环地址：server 拒绝监听非本机地址。
HOST=127.0.0.1
PORT=8787

# web 开发服务器（vite.config.ts）也从这份根 .env 读取 VITE_SERVER_ORIGIN，
# 用来设置 /api 的代理目标；进程环境变量优先于该文件。
# 只取这一个键：其他变量不会被 web 读取，也不会注入到客户端 import.meta.env
# （vite 的 envDir 仍是 apps/web，根 .env 不参与客户端变量生成）。
VITE_SERVER_ORIGIN=http://127.0.0.1:8787

# 可选：覆盖 Pi runtime 的本地数据位置（默认在 apps/server/data 下，已被忽略）。
# RUNTIME_SQLITE_PATH=apps/server/data/runtime.sqlite
# RUNTIME_NOTES_DIR=apps/server/data/notes

# 产品业务库：留空则使用本项目开发集群（npm run pg:start 生成，密码存忽略文件）。
# 填了就直接用这个 URL，server 不再读开发集群配置。不要把真实密码写进仓库。
# DATABASE_URL=postgres://postgres:<password>@127.0.0.1:55434/waterbot
# 开发集群端口（默认 55434；55432 在本机被 Windows 端口策略拒绝）
# PG_PORT=55434

# QQ（OneBot v11 正向 WebSocket，协议端如 NapCat 单独运行）。三项都不填则不启用。
# Bot 必须是专用小号；owner 身份只认这里的 QQ 号。
# ONEBOT_WS_URL=ws://127.0.0.1:3001
# ONEBOT_ACCESS_TOKEN=
# QQ_BOT_ID=
# QQ_OWNER_ID=
# 可选：Bot 使用的人格，默认第一个人格。
# QQ_PROFILE_ID=
# 真实外发开关：设为 1 才会向 QQ 发消息，默认只接收。
# QQ_ALLOW_SEND=0

# 联网查证默认走 Bing，免注册、免密钥。设为 1 可关闭。
# SEARCH_DISABLED=0
# 每 24 小时最多搜索次数，默认 100。
# SEARCH_DAILY_LIMIT=100
# 可选：填了 Tavily 密钥就改用 Tavily。
# TAVILY_API_KEY=
